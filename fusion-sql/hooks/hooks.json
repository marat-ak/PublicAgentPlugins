{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/skill-record.mjs"
          }
        ]
      },
      {
        "matcher": "mcp__[A-Za-z0-9_-]+__(createDataModelFile|setDatasetSql|updateDataModelFile|addStructureElement|moveStructureElement|removeStructureElement|editStructure|editParameters|editLexicals|editDatasets|editTriggers|editValueSets|editBursting|editProperties|editValidations|createReportFile|updateReportFile|addReportLayout|setReportLayout|modifyReportLayout|editLayout|createSubtemplateFile|instantiateTemplate)",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/skill-gate.mjs"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-compact.sh"
          }
        ]
      }
    ]
  }
}
